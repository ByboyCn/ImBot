<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ImBot.Host</RootNamespace>
  </PropertyGroup>
  <!-- 宿主永远只认识 Core。插件由 Directory.Build.props 自动拷入 plugins\，宿主运行时扫描。 -->
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ImBot.Core/ImBot.Core.csproj" />
  </ItemGroup>
</Project>
